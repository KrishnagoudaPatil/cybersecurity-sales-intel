# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Data (large / regenerable) — keep the sample, ignore bulk
data/raw/*
!data/raw/.gitkeep

# Traces / eval run outputs (keep committed results doc, ignore raw run logs)
traces/*.jsonl
evals/runs/*
!evals/runs/.gitkeep

# dbt build artifacts (regenerable)
snowflake/dbt_firmable/target/
snowflake/dbt_firmable/logs/
snowflake/dbt_firmable/dbt_packages/

# IDE
.idea/

# OS
.DS_Store

# local secrets (keys)
.secrets/
