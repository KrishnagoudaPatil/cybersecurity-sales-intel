# Copy to backend/.env (or repo-root .env). Without an ANTHROPIC_API_KEY the LLM layer
# runs in deterministic MOCK mode (evals, traces, cost all still work).
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-sonnet-5

# Where the app reads prospects from:
#   local     -> data/marts/*.json snapshot (default; publish with app.export_marts)
#   snowflake -> live queries (needs SNOWFLAKE_* below + the 3.12 venv w/ connector)
DATA_BACKEND=local

# Only needed for DATA_BACKEND=snowflake or the export script (key-pair auth):
# SNOWFLAKE_ACCOUNT=...
# SNOWFLAKE_USER=...
# SNOWFLAKE_ROLE=SYSADMIN
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=FIRMABLE
# SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_rsa_key.p8
